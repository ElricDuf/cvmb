# Copy to .env and set your PostgreSQL connection URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# =========================================================
# API SIRENE / INSEE — auto-remplissage des champs entreprise par SIRET
# =========================================================
# Clé d'API obtenue sur https://portail-api.insee.fr/ :
#   1. Créer une application
#   2. SOUSCRIRE à l'API Sirene avec le plan « API Key »
#   3. Ouvrir la souscription pour copier la clé
# Si la clé n'est pas renseignée, l'auto-remplissage est désactivé et
# l'utilisateur saisit les champs manuellement (fallback).
SIRENE_API_KEY="95c85962-a41f-465f-8859-62a41f465f46"

# Mode d'authentification :
#   apikey  (défaut) -> portail actuel : en-tête X-INSEE-Api-Key-Integration
#   bearer           -> ancienne plateforme : Authorization: Bearer <clé> (OAuth2)
SIRENE_AUTH_MODE="apikey"

# Optionnel : URL de base de l'API.
#   Portail actuel (défaut) : https://api.insee.fr/api-sirene/3.11
#   Ancienne plateforme     : https://api.insee.fr/entreprises/sirene/V3
# SIRENE_API_BASE="https://api.insee.fr/api-sirene/3.11"

# Optionnel : nom de l'en-tête de clé (mode apikey) si l'INSEE le modifie.
# SIRENE_API_KEY_HEADER="X-INSEE-Api-Key-Integration"

# Secret de signature des tokens d'authentification (admin).
# À définir avec une valeur aléatoire forte en production.
AUTH_SECRET="change-me-with-a-long-random-string"

# Origine(s) autorisée(s) pour CORS. Plusieurs origines séparées par virgule.
# En développement : http://localhost:3000
# En production    : https://votre-domaine.fr
FRONTEND_URL="http://localhost:3000"
