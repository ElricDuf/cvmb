{
  "name": "cvmb-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "prisma": "prisma",
    "db:migrate": "npx prisma migrate deploy",
    "db:migrate:dev": "npx prisma migrate dev --name init",
    "db:seed": "node prisma/seed.js",
    "prepare-db": "node prisma/prepare-db.js",
    "setup-db": "npx prisma migrate deploy && node prisma/seed.js",
    "reset-db": "npx prisma migrate reset --force && node prisma/seed.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "pg": "^8.0.0",
    "axios": "^1.4.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0"
  }
}
